{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexwei0413/coembank/docs/issue-5/project-war-room.schema.json",
  "title": "CAIOS Project War Room Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "source_cutoff_at",
    "timezone",
    "mode",
    "projects"
  ],
  "properties": {
    "schema_version": { "const": "0.1-draft" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "source_cutoff_at": { "type": "string", "format": "date-time" },
    "timezone": { "const": "Asia/Taipei" },
    "mode": { "const": "DRY_RUN" },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "evidenceStatus": {
      "enum": [
        "VERIFIED",
        "INFERRED",
        "UNKNOWN",
        "CONFLICT",
        "NOT_READY",
        "BLOCKED_EXTERNAL"
      ]
    },
    "trafficLight": {
      "enum": ["正常", "注意", "延誤", "未知"]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "ref", "observed_at"],
      "properties": {
        "source": {
          "enum": ["RAGIC", "TEAMS", "PLANNER", "FILE", "ISSUE", "FIXTURE"]
        },
        "ref": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "owner", "status"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OPEN", "RESOLVED", "UNKNOWN"] },
        "needed_by": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "directorDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "needed_by", "status"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "needed_by": {
          "type": ["string", "null"],
          "format": "date"
        },
        "status": { "enum": ["PENDING", "DECIDED", "UNKNOWN"] }
      }
    },
    "verifiedProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "verified_at", "evidence_refs"],
      "properties": {
        "summary": { "type": "string" },
        "verified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "case_key",
        "case_name",
        "owners",
        "collaborators",
        "phase",
        "last_verified_progress",
        "today_completed",
        "next_step",
        "planned_completion_date",
        "blockers",
        "director_decisions",
        "evidence_refs",
        "evidence_status",
        "traffic_light",
        "last_verified_at",
        "verified_by"
      ],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "case_key": { "type": "string", "minLength": 1 },
        "case_name": { "type": "string", "minLength": 1 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "collaborators": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "phase": { "type": "string", "minLength": 1 },
        "last_verified_progress": {
          "$ref": "#/$defs/verifiedProgress"
        },
        "today_completed": { "type": "string" },
        "next_step": { "type": "string" },
        "planned_completion_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        },
        "director_decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/directorDecision" }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "evidence_status": { "$ref": "#/$defs/evidenceStatus" },
        "traffic_light": { "$ref": "#/$defs/trafficLight" },
        "last_verified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "verified_by": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_status": { "const": "VERIFIED" }
            },
            "required": ["evidence_status"]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "type": "array",
                "minItems": 1
              },
              "last_verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "verified_by": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
